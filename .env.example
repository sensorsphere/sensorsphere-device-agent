# SensorSphere Device Agent
# Copy to .env and adjust values.
#DEVICE_AGENT_IMAGE=ghcr.io/sensorsphere/sensorsphere-device-agent:latest

# Required: SensorSphere base URL as visible from this agent.
SENSORSPHERE_URL=http://my_sensorsphere_base_url:8080

# Required: raw token shown by SensorSphere only at creation/regeneration.
SENSORSPHERE_DEVICE_AGENT_TOKEN=ssda_replace_me

# Human-readable agent name. Also sent as X-SensorSphere-Agent-Name.
#AGENT_NAME=device-agent-home

# Optional free-form labels, comma separated.
#AGENT_LABELS=site-home,lan-main

# Agent log level: debug, info, warn, error
#SENSORSPHERE_LOG_LEVEL=info

# WebSocket heartbeat interval.
#SENSORSPHERE_HEARTBEAT_INTERVAL_SECONDS=30

# Initial and maximum reconnect delays.
#SENSORSPHERE_RECONNECT_INITIAL_MS=1000
#SENSORSPHERE_RECONNECT_MAX_MS=30000

# Default Yeelight TCP request timeout.
#YEELIGHT_REQUEST_TIMEOUT_MS=5000

# ESPHome Native API request/state timeout.
#ESPHOME_REQUEST_TIMEOUT_MS=5000

# Optional global ESPHome Native API Noise PSK for devices controlled by this agent.
# Leave empty for unencrypted Native API endpoints.
#ESPHOME_NOISE_PSK=


# Optional Proxmox VE / Backup Server discovery endpoints.
# Keep API token secrets only on the Device Agent host. The endpoint id is a
# stable scope used in discovered provider identities and should not be renamed.
# PVE endpoints automatically discover PBS servers referenced by PVE storage
# configuration, so an explicit PBS entry is only needed for authenticated PBS
# enrichment (version/status/uptime). Example (single line):
#PROXMOX_ENDPOINTS_JSON=[{"id":"home-pve","product":"PVE","url":"https://pve-1.example.net:8006","tokenId":"sensorsphere@pve!discovery","tokenSecret":"replace_me","verifyTls":true}]

# Maximum timeout for each Proxmox API request.
#PROXMOX_REQUEST_TIMEOUT_MS=5000

# Optional local Supervisor Agent integration for centrally managed Device Agent updates.
# The socket directory is shared with sensorsphere-supervisor-agent on the host.
#SUPERVISOR_SOCKET_DIR=/run/sensorsphere-supervisor-agent
#SUPERVISOR_SOCKET_PATH=/run/sensorsphere-supervisor-agent/supervisor.sock
#SENSORSPHERE_SUPERVISOR_REQUEST_TIMEOUT_MS=130000

# Optional explicit WebSocket URL.
# If unset, the agent derives:
#   ws(s)://<SENSORSPHERE_URL>/api/v1/device-control/agent/ws
# SENSORSPHERE_DEVICE_AGENT_WS_URL=

# Docker Compose host-side data directory (used for ${DATA_DIR} substitution).
#DATA_DIR=./data

# SensorSphere Device Agent
# Copy to .env and adjust values.
#DEVICE_AGENT_IMAGE=ghcr.io/sensorsphere/sensorsphere-device-agent:latest

# Required: SensorSphere base URL as visible from this agent.
SENSORSPHERE_URL=http://my_sensorsphere_base_url:8080

# Required: raw token shown by SensorSphere only at creation/regeneration.
SENSORSPHERE_DEVICE_AGENT_TOKEN=ssda_replace_me

# Human-readable agent name. Also sent as X-SensorSphere-Agent-Name.
#AGENT_NAME=device-agent-home

# Optional free-form labels, comma separated.
#AGENT_LABELS=site-home,lan-main

# Agent log level: debug, info, warn, error
#SENSORSPHERE_LOG_LEVEL=info

# WebSocket heartbeat interval.
#SENSORSPHERE_HEARTBEAT_INTERVAL_SECONDS=30

# Initial and maximum reconnect delays.
#SENSORSPHERE_RECONNECT_INITIAL_MS=1000
#SENSORSPHERE_RECONNECT_MAX_MS=30000

# Default Yeelight TCP request timeout.
#YEELIGHT_REQUEST_TIMEOUT_MS=5000

# Optional explicit WebSocket URL.
# If unset, the agent derives:
#   ws(s)://<SENSORSPHERE_URL>/api/v1/device-control/agent/ws
# SENSORSPHERE_DEVICE_AGENT_WS_URL=

# Docker Compose host-side data directory (used for ${DATA_DIR} substitution).
#DATA_DIR=./data
